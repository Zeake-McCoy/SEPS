<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:SEPS.Core"
        xmlns:gl="using:SEPS.UI.Controls"        
        x:Class="SEPS.UI.MainWindow"
        Width="1400" Height="850"
        MinWidth="1000" MinHeight="650"
        Opened="MainWindow_Opened"
        Title="SEPS — Space Engineers Planet Studio">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="Open Planet Mod Folder…" Click="OpenPlanet_Click"/>
        <MenuItem x:Name="SwitchPlanetMenu"
                  Header="Switch Planet"
                  IsEnabled="False"/>
        <Separator/>
        <MenuItem Header="Exit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Face Workspace"
                  IsChecked="True"
                  IsEnabled="False"/>
        <MenuItem Header="Globe Workspace"
                  IsEnabled="False"/>
        <Separator/>
        <MenuItem Header="Reset / Fit View"
                  Click="ResetView_Click"/>
        <Separator/>
        <MenuItem Header="Debug">
          <MenuItem Header="RGB Material Map"
                    IsEnabled="False"/>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About SEPS" Click="About_Click"/>
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="#252525" Padding="8">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Face:" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <Button Content="Front" Tag="Front" Click="Face_Click"/>
        <Button Content="Back" Tag="Back" Click="Face_Click"/>
        <Button Content="Left" Tag="Left" Click="Face_Click"/>
        <Button Content="Right" Tag="Right" Click="Face_Click"/>
        <Button Content="Top" Tag="Top" Click="Face_Click"/>
        <Button Content="Bottom" Tag="Bottom" Click="Face_Click"/>
        <Separator Margin="8,0"/>
        <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="4,0"/>
        <Button Content="Terrain"/>
        <Button Content="Materials"/>
        <Button Content="Resources"/>
        <Button Content="Ecosystem"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Left"
            Width="82"
            Background="#1B1B1B"
            Padding="6">
      <StackPanel Spacing="6">
        <TextBlock
            Text="Tools"
            FontSize="14"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,2,0,6"/>
        <Button
            Content="Select"
            IsEnabled="False"
            Height="52"/>
        <Button
            Content="Inspect"
            IsEnabled="False"
            Height="52"/>
        <Button
            Content="Measure"
            IsEnabled="False"
            Height="52"/>
        <Separator
            Margin="0,4"/>
        <Button
            Content="Tool 1"
            IsEnabled="False"
            Height="52"/>
        <Button
            Content="Tool 2"
            IsEnabled="False"
            Height="52"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Right" Width="250" Background="#202020" Padding="12">
      <StackPanel Spacing="10">
        <TextBlock Text="Layers" FontSize="20" FontWeight="Bold"/>
        <CheckBox Content="Terrain" IsChecked="True"/>
        <CheckBox Content="Materials / Biomes" IsChecked="True"/>
        <CheckBox Content="Resources" IsChecked="True"/>
        <CheckBox Content="Ecosystem" IsChecked="True"/>
        <CheckBox Content="Water" IsChecked="True"/>
        <CheckBox Content="Topographic Lines"/>
        <CheckBox Content="Geographic Grid"/>
        <CheckBox Content="Wireframe"/>
        <Separator Margin="0,8"/>
        <TextBlock Text="Planet"
           FontSize="16"
           FontWeight="Bold"
           Margin="0,0,0,8"/>
        <ComboBox x:Name="PlanetSelector"
                  SelectionChanged="PlanetSelector_SelectionChanged"
                  HorizontalAlignment="Stretch"
                  Margin="0,0,0,6">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="core:Planet">
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="SubtypeId"
                  FontWeight="SemiBold"/>
        <TextBlock x:Name="PlanetSubtypeText"
                  Margin="0,0,0,6"/>
        <TextBlock Text="Generator Definition"
                  FontWeight="SemiBold"/>
        <TextBlock x:Name="GeneratorDefinitionText"
                  Margin="0,0,0,10"/>
        <Separator Margin="0,0,0,10"/>
        <TextBlock x:Name="FaceInfoText"
           Text="Face: Front"
           Margin="0,0,0,4"/>
        <TextBlock
            Text="Viewport"
            FontWeight="SemiBold"
            Margin="0,4,0,0"/>
        <TextBlock
            x:Name="ViewportInfoText"
            Text="Zoom: 1.00×"
            Margin="0,0,0,4"/>
        <TextBlock Text="Water: static overlay (MVP)"/>
      </StackPanel>
    </Border>
    <Grid RowDefinitions="*,Auto">
      <Border x:Name="MapWorkspace"
              Grid.Row="0"
              Background="#111111"
              Margin="8,8,8,4"
              CornerRadius="4"
              Focusable="True"
              PointerWheelChanged="MapWorkspace_PointerWheelChanged"
              PointerPressed="MapWorkspace_PointerPressed"
              PointerMoved="MapWorkspace_PointerMoved"
              PointerReleased="MapWorkspace_PointerReleased"
              KeyDown="MapWorkspace_KeyDown"
              KeyUp="MapWorkspace_KeyUp"
              LostFocus="MapWorkspace_LostFocus">
        <Grid>
          <gl:SEPSOpenGlViewport
              x:Name="GlViewport"/>
          <Border x:Name="ViewportOverlay"
                  Background="Transparent"
                  IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <Border Grid.Row="1"
              Background="#1B1B1B"
              Margin="8,0,8,8"
              Padding="6,4">
        <TextBlock
            x:Name="StatusText"
            Text="Initializing renderer..."
            VerticalAlignment="Center"
            Opacity="0.75"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
